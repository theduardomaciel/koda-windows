<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Koda.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:helpers="using:Koda.Helpers"
    xmlns:controls="using:Koda.Controls"
    Title="Koda">

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- One row for both rich music suggestions and plain query suggestions.
                 See docs/search-suggestions.md before changing the metrics. -->
            <Style
                x:Key="SearchSuggestionItemStyle"
                TargetType="ListViewItem"
                BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualMargin" Value="0" />
            </Style>

            <DataTemplate x:Key="SearchSuggestionTemplate">
                <Border
                    HorizontalAlignment="Stretch"
                    ToolTipService.ToolTip="{Binding ToolTip}"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.HelpText="{Binding HelpText}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Zero-height row keeps the divider out of layout, so the
                                 hover/focus rectangle is the same on every row. -->
                            <RowDefinition Height="0" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Height="1"
                            VerticalAlignment="Top"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Visibility="{Binding ShowsDivider, Converter={StaticResource BoolToVisibility}}"
                            IsHitTestVisible="False" />

                        <Grid
                            Grid.Row="1"
                            MinHeight="{Binding RowHeight}"
                            Padding="12,4"
                            ColumnSpacing="12"
                            VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="{Binding ArtSize}"
                                Height="{Binding ArtSize}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="{Binding ArtRadius}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid>
                                    <FontIcon
                                        Glyph="{Binding KindGlyph}"
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Image
                                        helpers:Art.Pixels="{Binding ArtSize}"
                                        helpers:Art.Source="{Binding Artwork}"
                                        Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    Text="{Binding Title}"
                                    helpers:Highlight.Query="{Binding Query}"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Text="{Binding Detail}"
                                    Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>

                            <FontIcon
                                Grid.Column="2"
                                Glyph="{Binding TrailingGlyph}"
                                Visibility="{Binding HasTrailing, Converter={StaticResource BoolToVisibility}}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar is the WinUI TitleBar control over Mica. It owns the drag
             region and the space the native caption buttons need, so the account chip
             and the search field are laid out against the real system inset instead of
             a width this app has to reserve by hand. -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="Koda"
            IsBackButtonVisible="False"
            BackRequested="OnBackRequested"
            IsPaneToggleButtonVisible="False"
            PaneToggleRequested="OnPaneToggleRequested"
            Background="Transparent">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/icon.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="TitleSearch"
                    Width="420"
                    Height="34"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    PlaceholderText="Songs, albums, artists or a link"
                    QueryIcon="Find"
                    ItemTemplate="{StaticResource SearchSuggestionTemplate}"
                    ItemContainerStyle="{StaticResource SearchSuggestionItemStyle}"
                    TextMemberPath="Text"
                    UpdateTextOnSelect="False"
                    MaxSuggestionListHeight="420"
                    AutoMaximizeSuggestionArea="False"
                    TextChanged="OnSearchTextChanged"
                    QuerySubmitted="OnSearchSubmitted"
                    AutomationProperties.Name="Search YouTube Music">
                    <AutoSuggestBox.Resources>
                        <!-- A quieter, more rectangular suggestion surface. -->
                        <CornerRadius x:Key="OverlayCornerRadius">4</CornerRadius>
                        <CornerRadius x:Key="ListViewItemCornerRadius">4</CornerRadius>
                        <!-- The hover fill is the selection cue; the extra accent
                             pill at the left edge looks like a stray line here. -->
                        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                    </AutoSuggestBox.Resources>
                    <!-- The built-in TitleBar centers Content in the space left after the
                         account chip, min drag strip and caption inset. Nudge the field
                         right so it reads closer to the window's center. -->
                    <AutoSuggestBox.RenderTransform>
                        <TranslateTransform x:Name="TitleSearchOffset" />
                    </AutoSuggestBox.RenderTransform>
                </AutoSuggestBox>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Button
                    x:Name="TitleProfileButton"
                    Height="36"
                    Margin="4,0,8,0"
                    Padding="8,0,8,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="4"
                    Click="OnProfileButtonClick"
                    ToolTipService.ToolTip="Switch profile"
                    AutomationProperties.Name="Switch profile">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PersonPicture x:Name="TitleProfilePicture" Width="26" Height="26" />
                        <TextBlock
                            x:Name="TitleProfileName"
                            MaxWidth="140"
                            VerticalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <FontIcon
                            Glyph="&#xE70D;"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- The content below the title bar zooms as one: Ctrl + and Ctrl - change it, while
             the title bar and caption buttons stay native. The content lays out at the
             window size divided by the zoom, then is scaled back up: text grows and less
             fits, as with a browser zoom. -->
        <Grid x:Name="ZoomHost" Grid.Row="1">
            <Grid
                x:Name="ZoomContent"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                RenderTransformOrigin="0,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ZoomScale" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The page area and its lyrics drawer. SplitView pushes the page aside
                     when there is room and floats the drawer above it when the window is
                     narrow; the player bar below stays the full width either way, so the
                     transport never loses its controls to the panel. CompactInline with a
                     zero compact length uses the framework's compact-right transition: the
                     page takes its new width at once and the pane's clip edge wipes in,
                     unlike Inline-right, which slides the whole page sideways first. -->
                <SplitView
                    x:Name="SidePanel"
                    Grid.Row="0"
                    DisplayMode="CompactInline"
                    PanePlacement="Right"
                    OpenPaneLength="380"
                    CompactPaneLength="0"
                    IsPaneOpen="False"
                    PaneClosing="OnSidePaneClosing"
                    PaneClosed="OnSidePaneClosed">
                    <SplitView.Pane>
                        <Grid>
                            <controls:InlineLyricsPane
                                x:Name="InlineLyrics"
                                CloseRequested="OnLyricsCloseRequested" />
                            <controls:InlineQueuePane
                                x:Name="InlineQueue"
                                Visibility="Collapsed"
                                CloseRequested="OnQueueCloseRequested" />
                        </Grid>
                    </SplitView.Pane>
                    <SplitView.Content>
                        <muxc:NavigationView
                            x:Name="Nav"
                            PaneDisplayMode="Left"
                            OpenPaneLength="264"
                            CompactPaneLength="52"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="True"
                            IsTitleBarAutoPaddingEnabled="False"
                            ItemInvoked="OnNavItemInvoked">
                            <muxc:NavigationView.MenuItems>
                                <muxc:NavigationViewItem Content="Home" Tag="home" ToolTipService.ToolTip="Home">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE80F;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem Content="Browse" Tag="browse" ToolTipService.ToolTip="Browse moods and genres">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE8A9;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem x:Name="SearchResultsItem" Content="Search Results" Tag="search" Visibility="Collapsed" ToolTipService.ToolTip="Search results">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE721;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>

                                <muxc:NavigationViewItemHeader x:Name="VideosHeader" Content="Videos" />
                                <muxc:NavigationViewItem x:Name="VideoHomeItem" Content="Videos" Tag="video-home" ToolTipService.ToolTip="Videos for you">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE714;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem x:Name="VideoSubscriptionsItem" Content="Subscriptions" Tag="video-subscriptions" ToolTipService.ToolTip="The latest from your channels">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE8F2;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem x:Name="VideoExploreItem" Content="Explore" Tag="video-explore" ToolTipService.ToolTip="Music, news, sports and learning">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE7C3;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem x:Name="VideoChannelsItem" Content="Channels" Tag="video-channels" ToolTipService.ToolTip="Channels you subscribe to">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE716;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem x:Name="VideoLaterItem" Content="Watch Later" Tag="video-later" ToolTipService.ToolTip="Watch Later">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE728;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem x:Name="VideoLikedItem" Content="Liked Videos" Tag="video-liked" ToolTipService.ToolTip="Liked Videos">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE8E1;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem x:Name="VideoHistoryItem" Content="Watch History" Tag="video-history" ToolTipService.ToolTip="Videos you've watched">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE81C;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>

                                <muxc:NavigationViewItemHeader Content="Library" />
                                <muxc:NavigationViewItem Content="Recently Played" Tag="recent" ToolTipService.ToolTip="Recently Played">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE823;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem Content="History" Tag="history" ToolTipService.ToolTip="Every play, by the day">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE81C;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem x:Name="LikedItem" Content="Liked Songs" Tag="liked" ToolTipService.ToolTip="Liked Songs">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xEB52;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem Content="Albums" Tag="albums" ToolTipService.ToolTip="Saved albums">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE93C;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem Content="Playlists" Tag="playlists" ToolTipService.ToolTip="Saved playlists">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE8FD;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem Content="Artists" Tag="artists" ToolTipService.ToolTip="Followed artists">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE77B;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem x:Name="DownloadsItem" Content="Downloads" Tag="downloads" ToolTipService.ToolTip="Downloads">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE896;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem Content="Ready Offline" Tag="offline" ToolTipService.ToolTip="Songs kept on this PC">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE709;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem Content="Listening Stats" Tag="stats" ToolTipService.ToolTip="Listening Stats">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE9D9;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                                <muxc:NavigationViewItem Content="Last.fm" Tag="lastfm" ToolTipService.ToolTip="Scrobble what you play to Last.fm">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xEC05;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>

                                <muxc:NavigationViewItemHeader Content="Your playlists" />
                                <muxc:NavigationViewItem x:Name="NewPlaylistItem" Content="New Playlist" Tag="new-playlist" SelectsOnInvoked="False" ToolTipService.ToolTip="Make a new playlist">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE710;" />
                                    </muxc:NavigationViewItem.Icon>
                                </muxc:NavigationViewItem>
                            </muxc:NavigationView.MenuItems>

                            <muxc:NavigationView.FooterMenuItems>
                                <!-- What plays next and today's listening, as ordinary two-line rows: they line up
                                     with the rest of the pane, keep its hover and focus, and shrink to their icon
                                     when the pane is compact. -->
                                <muxc:NavigationViewItem
                                    x:Name="UpNextItem"
                                    Tag="up-next"
                                    SelectsOnInvoked="False"
                                    Visibility="Collapsed">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE8D6;" />
                                    </muxc:NavigationViewItem.Icon>
                                    <StackPanel VerticalAlignment="Center" Margin="0,5">
                                        <TextBlock x:Name="UpNextTitle" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock
                                            x:Name="UpNextArtist"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </muxc:NavigationViewItem>

                                <muxc:NavigationViewItem
                                    x:Name="GlanceItem"
                                    Tag="glance"
                                    SelectsOnInvoked="False">
                                    <muxc:NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE7F6;" />
                                    </muxc:NavigationViewItem.Icon>
                                    <StackPanel VerticalAlignment="Center" Margin="0,5">
                                        <TextBlock x:Name="GlanceListened" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock
                                            x:Name="GlanceStreak"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </muxc:NavigationViewItem>
                            </muxc:NavigationView.FooterMenuItems>

                            <Grid>
                                <Frame x:Name="ContentFrame" />
                                <!-- Non-blocking notes and faults: never a dialog. -->
                                <muxc:InfoBar
                                    x:Name="StatusRibbon"
                                    MaxWidth="640"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,12"
                                    Padding="12,8"
                                    CornerRadius="8"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    IsOpen="False"
                                    IsClosable="True"
                                    CloseButtonClick="OnStatusClosed" />
                            </Grid>
                        </muxc:NavigationView>
                    </SplitView.Content>
                </SplitView>

                <!-- Player bar on the window's Mica, a hairline above it:
                     now playing (left) | transport over the scrubber (center) | volume (right). -->
                <Grid
                    x:Name="PlayerBar"
                    Grid.Row="1"
                    Height="84"
                    Padding="12,0"
                    ColumnSpacing="16"
                    SizeChanged="OnPlayerBarSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="2*" MaxWidth="620" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="3" Height="1" Margin="-12,0" VerticalAlignment="Top" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid x:Name="TrackInfo" ColumnSpacing="12" VerticalAlignment="Center" SizeChanged="OnTrackInfoSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Hovering the cover dims the art and shows the expand glyph, so the
                             way into Now Playing reads as a control rather than a picture. The
                             scrim ignores hit-testing to keep the Border's tap and pointer
                             events intact. -->
                        <Border
                            Width="56"
                            Height="56"
                            CornerRadius="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Tapped="OnNowPlayingTapped"
                            PointerEntered="OnCoverPointerEntered"
                            PointerExited="OnCoverPointerExited"
                            ToolTipService.ToolTip="Open Now Playing"
                            AutomationProperties.Name="Open Now Playing">
                            <Grid>
                                <FontIcon x:Name="CoverGlyph" Glyph="&#xE8D6;" FontSize="18" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Image x:Name="CoverImage" helpers:Art.Pixels="56" Stretch="UniformToFill" />
                                <Border
                                    x:Name="CoverHover"
                                    Background="#99000000"
                                    CornerRadius="8"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                    <FontIcon Glyph="&#xE740;" FontSize="18" Foreground="White" />
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="TrackInfoText" Grid.Column="1" MaxWidth="280" VerticalAlignment="Center" Spacing="1">
                            <TextBlock
                                x:Name="TrackTitleText"
                                Text="Nothing playing"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                MaxLines="1"
                                AutomationProperties.Name="Track title" />
                            <TextBlock
                                x:Name="TrackArtistText"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                MaxLines="1"
                                Tapped="OnArtistTapped"
                                AutomationProperties.Name="Track artist" />
                            <TextBlock
                                x:Name="NextUpText"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <Button
                            x:Name="LikeButton"
                            Grid.Column="2"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            Click="OnLikeClick"
                            ToolTipService.ToolTip="Add to Liked"
                            AutomationProperties.Name="Add to Liked">
                            <FontIcon x:Name="LikeIcon" Glyph="&#xEB51;" FontSize="16" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <ToggleButton
                                x:Name="ShuffleButton"
                                Width="36"
                                Height="36"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                IsEnabled="False"
                                Click="OnShuffleClick"
                                ToolTipService.ToolTip="Shuffle"
                                AutomationProperties.Name="Shuffle">
                                <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                            </ToggleButton>
                            <Button
                                x:Name="PreviousButton"
                                Width="36"
                                Height="36"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                IsEnabled="False"
                                Click="OnPrevClick"
                                ToolTipService.ToolTip="Previous"
                                AutomationProperties.Name="Previous">
                                <FontIcon Glyph="&#xE892;" FontSize="16" />
                            </Button>
                            <Button
                                x:Name="SkipBackButton"
                                Width="36"
                                Height="36"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                IsEnabled="False"
                                Click="OnSkipBackClick"
                                ToolTipService.ToolTip="Back 10 seconds"
                                AutomationProperties.Name="Back 10 seconds">
                                <controls:SkipIcon x:Name="SkipBackIcon" Direction="Back" Seconds="10" Width="18" Height="18" />
                            </Button>
                            <Button
                                x:Name="PlayPauseButton"
                                Width="40"
                                Height="40"
                                Padding="0"
                                CornerRadius="20"
                                IsEnabled="False"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OnPlayPauseClick"
                                ToolTipService.ToolTip="Play (Space)"
                                AutomationProperties.Name="Play">
                                <Grid>
                                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xF5B0;" FontSize="16" />
                                    <ProgressRing x:Name="BarLoading" Width="20" Height="20" IsActive="False" Visibility="Collapsed" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Grid>
                            </Button>
                            <Button
                                x:Name="SkipForwardButton"
                                Width="36"
                                Height="36"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                IsEnabled="False"
                                Click="OnSkipForwardClick"
                                ToolTipService.ToolTip="Ahead 10 seconds"
                                AutomationProperties.Name="Ahead 10 seconds">
                                <controls:SkipIcon x:Name="SkipForwardIcon" Direction="Forward" Seconds="10" Width="18" Height="18" />
                            </Button>
                            <Button
                                x:Name="NextButton"
                                Width="36"
                                Height="36"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                IsEnabled="False"
                                Click="OnNextClick"
                                ToolTipService.ToolTip="Next"
                                AutomationProperties.Name="Next">
                                <FontIcon Glyph="&#xE893;" FontSize="16" />
                            </Button>
                            <ToggleButton
                                x:Name="RepeatButton"
                                Width="36"
                                Height="36"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                IsEnabled="False"
                                Click="OnRepeatClick"
                                ToolTipService.ToolTip="Repeat"
                                AutomationProperties.Name="Repeat">
                                <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="14" />
                            </ToggleButton>
                        </StackPanel>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElapsedText" VerticalAlignment="Center" TextAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Slider
                                x:Name="Scrubber"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="1"
                                IsEnabled="False"
                                IsThumbToolTipEnabled="False"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Playback position" />
                            <TextBlock x:Name="TotalText" Grid.Column="2" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                        <Button
                            x:Name="MiniButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            IsEnabled="False"
                            Click="OnMiniClick"
                            ToolTipService.ToolTip="Mini player"
                            AutomationProperties.Name="Mini player">
                            <FontIcon Glyph="&#xE9A6;" FontSize="16" />
                        </Button>
                        <ToggleButton
                            x:Name="LyricsButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            IsEnabled="False"
                            Click="OnLyricsClick"
                            ToolTipService.ToolTip="Lyrics"
                            AutomationProperties.Name="Lyrics">
                            <FontIcon Glyph="&#xE8F2;" FontSize="16" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="QueueButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            IsEnabled="False"
                            Click="OnQueueClick"
                            ToolTipService.ToolTip="Queue"
                            AutomationProperties.Name="Queue">
                            <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                        </ToggleButton>
                        <Button
                            x:Name="OutputButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnOutputClick"
                            ToolTipService.ToolTip="Audio output"
                            AutomationProperties.Name="Audio output">
                            <FontIcon Glyph="&#xE7F5;" FontSize="16" />
                        </Button>
                        <Button
                            x:Name="MuteButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnMuteClick"
                            ToolTipService.ToolTip="Mute"
                            AutomationProperties.Name="Mute">
                            <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="16" />
                        </Button>
                        <Button
                            x:Name="BarVolumeButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Volume"
                            AutomationProperties.Name="Volume">
                            <FontIcon x:Name="BarVolumeIcon" Glyph="&#xE767;" FontSize="16" />
                            <Button.Flyout>
                                <Flyout Placement="Top" Opening="OnBarVolumeFlyoutOpening">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="8" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Width="200">
                                        <Button
                                            x:Name="BarVolumeMuteButton"
                                            Width="36"
                                            Height="36"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnMuteClick"
                                            ToolTipService.ToolTip="Mute"
                                            AutomationProperties.Name="Mute">
                                            <FontIcon x:Name="BarVolumeMuteIcon" Glyph="&#xE767;" FontSize="16" />
                                        </Button>
                                        <Slider
                                            x:Name="BarVolumeSlider"
                                            Width="150"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="100"
                                            ValueChanged="OnBarVolumeChanged"
                                            AutomationProperties.Name="Volume" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Slider
                            x:Name="VolumeSlider"
                            Width="110"
                            VerticalAlignment="Center"
                            Minimum="0"
                            Maximum="100"
                            Value="100"
                            ValueChanged="OnVolumeChanged"
                            AutomationProperties.Name="Volume" />
                        <Button
                            x:Name="BarMoreButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            Click="OnBarMoreClick"
                            ToolTipService.ToolTip="More player actions"
                            AutomationProperties.Name="More player actions">
                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- The video going on while the rest of Koda is browsed: its live picture, what it
                     is, play and the scrubber. Tapping it goes back to the watch page. -->
                <Grid
                    x:Name="VideoBar"
                    Grid.Row="1"
                    Height="84"
                    Padding="12,0"
                    ColumnSpacing="16"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="2*" MaxWidth="620" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="3" Height="1" Margin="-12,0" VerticalAlignment="Top" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="12" VerticalAlignment="Center" Background="Transparent" Tapped="OnVideoBarTapped" ToolTipService.ToolTip="Back to the video">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="100" Height="56" CornerRadius="6" Background="Black">
                            <MediaPlayerElement x:Name="VideoBarPicture" AreTransportControlsEnabled="False" Stretch="UniformToFill" IsHitTestVisible="False" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="VideoBarTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock x:Name="VideoBarChannel" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <Button Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" Click="OnVideoBackClick" ToolTipService.ToolTip="Back 10 seconds" AutomationProperties.Name="Back 10 seconds">
                                <controls:SkipIcon Direction="Back" Seconds="10" Width="18" Height="18" />
                            </Button>
                            <Button x:Name="VideoPlayButton" Width="40" Height="40" Padding="0" CornerRadius="20" Style="{ThemeResource AccentButtonStyle}" Click="OnVideoPlayClick" ToolTipService.ToolTip="Play (Space)" AutomationProperties.Name="Play">
                                <FontIcon x:Name="VideoPlayIcon" Glyph="&#xF5B0;" FontSize="16" />
                            </Button>
                            <Button Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" Click="OnVideoAheadClick" ToolTipService.ToolTip="Ahead 10 seconds" AutomationProperties.Name="Ahead 10 seconds">
                                <controls:SkipIcon Direction="Forward" Seconds="10" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VideoElapsed" VerticalAlignment="Center" TextAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Slider x:Name="VideoScrubber" Grid.Column="1" Minimum="0" Maximum="1" IsThumbToolTipEnabled="False" VerticalAlignment="Center" AutomationProperties.Name="Video position" />
                            <TextBlock x:Name="VideoTotal" Grid.Column="2" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>

                    <Button Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" Click="OnVideoCloseClick" ToolTipService.ToolTip="Close video" AutomationProperties.Name="Close video">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </Grid>
            </Grid>

            <Border
                x:Name="ZoomBadge"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,16,0,0"
                Padding="14,7"
                CornerRadius="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                <TextBlock x:Name="ZoomBadgeText" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            </Border>
        </Grid>

    </Grid>
</Window>
