<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Koda.Controls.InlineQueuePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Koda.Helpers">

    <UserControl.Resources>
        <Style x:Key="QueueTabButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="QueueGlyphButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <DataTemplate x:Key="QueueRowTemplate">
            <Grid Height="56" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Image helpers:Art.Pixels="40" helpers:Art.Source="{Binding Song.Artwork}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding Song.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock
                        Text="{Binding Song.ArtistLine}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{Binding Song.Duration, Converter={StaticResource SecondsText}}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- The queue drawer: the same right-side surface as the lyrics, with the two views
         Apple Music offers — what plays next and what has played. -->
    <Border
        x:Name="Surface"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TabsRow" Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="Tabs" Padding="12,8,12,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="PlayingNextTab"
                    Content="Playing Next"
                    Style="{StaticResource QueueTabButton}"
                    Click="OnPlayingNextClick"
                    AutomationProperties.Name="Playing Next" />
                <ToggleButton
                    x:Name="HistoryTab"
                    Grid.Column="1"
                    Content="History"
                    Style="{StaticResource QueueTabButton}"
                    Click="OnHistoryClick"
                    AutomationProperties.Name="History" />
            </Grid>

            <Grid Grid.Row="1" Padding="12,4,8,6" MinHeight="40">
                <TextBlock
                    x:Name="SectionTitle"
                    Text="Playing Next"
                    FontSize="16"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <HyperlinkButton
                        x:Name="ClearButton"
                        Content="Clear"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Click="OnClearClick"
                        ToolTipService.ToolTip="Clear what plays next"
                        AutomationProperties.Name="Clear queue" />
                    <ToggleButton
                        x:Name="AutoplayToggle"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnAutoplayClick"
                        ToolTipService.ToolTip="Autoplay: keep going with songs like the last one"
                        AutomationProperties.Name="Autoplay">
                        <TextBlock Text="∞" FontSize="18" LineHeight="18" VerticalAlignment="Center" />
                    </ToggleButton>
                    <Button
                        x:Name="CloseButton"
                        Style="{StaticResource QueueGlyphButton}"
                        Click="OnCloseClick"
                        ToolTipService.ToolTip="Close queue"
                        AutomationProperties.Name="Close queue">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <ListView
                    x:Name="UpNext"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    Margin="0,0,0,12"
                    ItemClick="OnItemClick"
                    DragItemsStarting="OnDragStarting"
                    DragItemsCompleted="OnDragCompleted"
                    ContextRequested="OnItemContext"
                    ItemContainerStyle="{StaticResource CatalogRowStyle}"
                    ItemTemplate="{StaticResource QueueRowTemplate}"
                    AutomationProperties.Name="Playing Next" />

                <ListView
                    x:Name="HistoryList"
                    Visibility="Collapsed"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    Margin="0,0,0,12"
                    ItemClick="OnItemClick"
                    ContextRequested="OnItemContext"
                    ItemContainerStyle="{StaticResource CatalogRowStyle}"
                    ItemTemplate="{StaticResource QueueRowTemplate}"
                    AutomationProperties.Name="History" />

                <TextBlock
                    x:Name="EmptyText"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
