<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Koda.Controls.InlineLyricsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="PaneGlyphButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
    </UserControl.Resources>

    <!-- The inline lyrics drawer: the page's own edge, a slim header, and the words.
         The panel follows the song exactly as Now Playing's does, but it follows the
         app's light and dark themes instead of the player's fixed dark surface. -->
    <Border
        x:Name="Surface"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="Header" Padding="16,0,8,0">
                <TextBlock
                    Text="Lyrics"
                    VerticalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button
                    x:Name="CloseButton"
                    Style="{StaticResource PaneGlyphButton}"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OnCloseClick"
                    ToolTipService.ToolTip="Close lyrics"
                    AutomationProperties.Name="Close lyrics">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
                <Border
                    Height="1"
                    Margin="-16,0,-8,0"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid x:Name="LyricsView">
                    <Grid x:Name="LyricsMaskedContent">
                        <ScrollViewer
                            x:Name="LyricsScroll"
                            Margin="4,0"
                            VerticalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Auto"
                            HorizontalScrollMode="Disabled"
                            AutomationProperties.Name="Lyrics">
                            <StackPanel x:Name="LyricsLines" />
                        </ScrollViewer>
                        <TextBlock
                            x:Name="LyricsEmpty"
                            Visibility="Collapsed"
                            Text="No lyrics for this song."
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                        <StackPanel
                            x:Name="LyricsLoading"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <ProgressRing Width="20" Height="20" IsActive="True" />
                            <TextBlock
                                Text="Finding lyrics…"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- The words fade at the top and bottom edges. White is only the
                         mask's reference channel; the text's own colours are the panel's. -->
                    <Border x:Name="LyricsMask" Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#FFFFFFFF" Offset="0.10" />
                                <GradientStop Color="#FFFFFFFF" Offset="0.90" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <!-- Shown immediately when the drawer swaps to the lyrics, before the
                     text surfaces are built; the build happens on the next dispatcher turn. -->
                <Border
                    x:Name="Preparing"
                    Visibility="Collapsed"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <ProgressRing Width="20" Height="20" IsActive="True" />
                        <TextBlock
                            Text="Finding lyrics…"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Shown when the listener scrolls away: hands the panel back to the song. -->
                <Button
                    x:Name="FollowLyricsButton"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    Padding="14,8"
                    CornerRadius="16"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Opacity="0"
                    IsHitTestVisible="False"
                    IsTabStop="False"
                    Click="OnFollowLyricsClick"
                    ToolTipService.ToolTip="Jump back to the line being sung"
                    AutomationProperties.Name="Follow the lyrics">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="FollowLyricsChevron" Glyph="&#xE70D;" FontSize="12" />
                        <TextBlock x:Name="FollowLyricsLabel" Text="Follow along" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
