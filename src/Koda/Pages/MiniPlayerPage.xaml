<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Koda.Pages.MiniPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Koda.Helpers"
    Background="Transparent">
    <Page.Resources>
        <!-- The mini player's glyph buttons: flat, round on hover, and the same at every DPI. -->
        <Style x:Key="MiniGlyphButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <Style x:Key="MiniTransportButton" TargetType="Button" BasedOn="{StaticResource MiniGlyphButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>
        <Style x:Key="MiniPlayButton" TargetType="Button" BasedOn="{StaticResource MiniGlyphButton}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
        </Style>
    </Page.Resources>

    <Grid x:Name="Root" SizeChanged="OnSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The title bar reaches into the page, so this transparent strip is what Windows
             drags. The caption area is a separate column: the app's full-player button and
             the native minimize/close buttons are client content there, not part of the drag
             region, so they stay clickable. -->
        <Grid Height="32" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="DragBar" Background="Transparent" />
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="MinimizeButton"
                    Width="32"
                    Height="32"
                    CornerRadius="16"
                    Style="{StaticResource MiniGlyphButton}"
                    Click="OnMinimizeClick"
                    ToolTipService.ToolTip="Minimize"
                    AutomationProperties.Name="Minimize">
                    <FontIcon Glyph="&#xE921;" FontSize="12" />
                </Button>
                <Button
                    x:Name="RestoreButton"
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    CornerRadius="16"
                    Style="{StaticResource MiniGlyphButton}"
                    Click="OnRestoreClick"
                    ToolTipService.ToolTip="Open the full player"
                    AutomationProperties.Name="Open the full player">
                    <FontIcon Glyph="&#xE740;" FontSize="12" />
                </Button>
                <!-- The window measures the native caption buttons into this spacer. -->
                <Border x:Name="CaptionInset" Grid.Column="2" Width="0" />
            </Grid>
        </Grid>

        <!-- Cover, what is playing, and the seek row. The title block spans both columns and
             centers on the card, but its MaxWidth (set from the page size) keeps it clear of
             the cover on the left and the same distance on the right. -->
        <Grid x:Name="Main" Margin="20,0" VerticalAlignment="Center" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="100" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="CoverHost"
                Width="100"
                Height="100"
                CornerRadius="8"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                DoubleTapped="OnRestoreTapped"
                ToolTipService.ToolTip="Open the full player"
                AutomationProperties.Name="Open the full player">
                <Grid>
                    <FontIcon
                        x:Name="CoverGlyph"
                        Glyph="&#xE8D6;"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Image x:Name="CoverImage" helpers:Art.Pixels="100" Stretch="UniformToFill" />
                </Grid>
            </Border>

            <StackPanel
                x:Name="TitleBlock"
                Grid.ColumnSpan="2"
                MaxWidth="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    x:Name="TitleText"
                    Text="Nothing playing"
                    FontSize="20"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    AutomationProperties.Name="Track title" />
                <TextBlock
                    x:Name="ArtistText"
                    FontSize="15"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    AutomationProperties.Name="Track artist" />
            </StackPanel>

            <TextBlock
                x:Name="ElapsedText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="13"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.Name="Elapsed time" />

            <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider
                    x:Name="Progress"
                    Margin="-6,0,0,0"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="1"
                    IsThumbToolTipEnabled="False"
                    ValueChanged="OnProgressChanged"
                    AutomationProperties.Name="Playback position">
                    <Slider.Resources>
                        <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
                        <x:Double x:Key="SliderHorizontalHeight">24</x:Double>
                        <!-- A slim vertical pill, like the reference: the default style's
                             white outer circle is dropped and only the inner thumb remains. -->
                        <x:Double x:Key="SliderInnerThumbWidth">4</x:Double>
                        <x:Double x:Key="SliderInnerThumbHeight">14</x:Double>
                        <CornerRadius x:Key="SliderThumbCornerRadius">7</CornerRadius>
                        <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource TextFillColorPrimary}" />
                        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{ThemeResource TextFillColorPrimary}" />
                    </Slider.Resources>
                </Slider>
                <TextBlock
                    x:Name="RemainingText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    AutomationProperties.Name="Remaining time" />
            </Grid>
        </Grid>

        <!-- Volume and options on the left, transport centered in the window, lyrics and the
             playing-next list on the right. The volume sits under the cover; the ellipsis
             starts where the cover ends. -->
        <Grid Grid.Row="1" Height="56" Margin="20,8,20,12">
            <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="VolumeButton"
                    HorizontalAlignment="Center"
                    Style="{StaticResource MiniGlyphButton}"
                    ToolTipService.ToolTip="Volume"
                    AutomationProperties.Name="Volume">
                    <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16" />
                    <Button.Flyout>
                        <Flyout Placement="Top" Opening="OnVolumeFlyoutOpening">
                            <StackPanel Orientation="Horizontal" Spacing="8" Width="200">
                                <Button
                                    x:Name="MuteButton"
                                    Style="{StaticResource MiniGlyphButton}"
                                    Click="OnMuteClick"
                                    ToolTipService.ToolTip="Mute"
                                    AutomationProperties.Name="Mute">
                                    <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="16" />
                                </Button>
                                <Slider
                                    x:Name="VolumeSlider"
                                    Width="150"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="100"
                                    AutomationProperties.Name="Volume" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="MoreButton"
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    Style="{StaticResource MiniGlyphButton}"
                    Click="OnMoreClick"
                    ToolTipService.ToolTip="More options"
                    AutomationProperties.Name="More options">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                </Button>
            </Grid>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <Button
                    x:Name="PreviousButton"
                    Style="{StaticResource MiniTransportButton}"
                    Click="OnPreviousClick"
                    ToolTipService.ToolTip="Previous"
                    AutomationProperties.Name="Previous">
                    <FontIcon Glyph="&#xE892;" FontSize="18" />
                </Button>
                <Button
                    x:Name="PlayButton"
                    Style="{StaticResource MiniPlayButton}"
                    Click="OnPlayClick"
                    ToolTipService.ToolTip="Play"
                    AutomationProperties.Name="Play">
                    <Grid>
                        <FontIcon x:Name="PlayIcon" Glyph="&#xF5B0;" FontSize="22" />
                        <ProgressRing
                            x:Name="LoadingRing"
                            Width="20"
                            Height="20"
                            IsActive="False"
                            Visibility="Collapsed"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Button>
                <Button
                    x:Name="NextButton"
                    Style="{StaticResource MiniTransportButton}"
                    Click="OnNextClick"
                    ToolTipService.ToolTip="Next"
                    AutomationProperties.Name="Next">
                    <FontIcon Glyph="&#xE893;" FontSize="18" />
                </Button>
            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Spacing="4">
                <Button
                    x:Name="LyricsButton"
                    Style="{StaticResource MiniGlyphButton}"
                    Click="OnLyricsClick"
                    ToolTipService.ToolTip="Lyrics"
                    AutomationProperties.Name="Lyrics">
                    <FontIcon Glyph="&#xE8F2;" FontSize="16" />
                </Button>
                <Button
                    x:Name="QueueButton"
                    Style="{StaticResource MiniGlyphButton}"
                    Click="OnQueueClick"
                    ToolTipService.ToolTip="Playing next"
                    AutomationProperties.Name="Playing next">
                    <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
