<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Koda.Pages.MiniPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Koda.Helpers"
    xmlns:controls="using:Koda.Controls"
    Background="Transparent">
    <Page.Resources>
        <ResourceDictionary>
            <!-- Filled from the same palette PaintCaptionButtons gives the native
                 caption buttons; the window updates the colors on a theme change. -->
            <SolidColorBrush x:Key="MiniCaptionHoverBrush" Color="Transparent" />
            <SolidColorBrush x:Key="MiniCaptionPressedBrush" Color="Transparent" />

            <!-- The expand button is the app's own caption button: square, full height and
                 with the same hover/pressed fills the system uses for the caption group. -->
            <Style x:Key="MiniCaptionButton" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="0">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{StaticResource MiniCaptionHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{StaticResource MiniCaptionPressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The mini player's glyph buttons: native Button chrome, sized for the card. -->
            <Style x:Key="MiniGlyphButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="MiniTransportButton" TargetType="Button" BasedOn="{StaticResource MiniGlyphButton}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
            </Style>
            <Style x:Key="MiniPlayButton" TargetType="Button" BasedOn="{StaticResource MiniGlyphButton}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
            </Style>

            <!-- The lyrics and queue buttons: the same glyph buttons, but they stay filled
                 while their panel is open in the expanded card. -->
            <Style x:Key="MiniToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="Root">
        <!-- One 16px card padding, then four rows:
             1. Cover | Title + Artist (the card's star row while compact)
             2. The lyrics or queue panel, zero height until the card is expanded
             3. Current time | Progress | Remaining time
             4. Volume + More | Transport | Lyrics + Queue -->
        <Grid x:Name="Card" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TrackRow" Height="*" MinHeight="80" />
                <RowDefinition x:Name="PanelRow" Height="0" />
                <RowDefinition Height="32" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <!-- Row 1: the cover and the title/artist column beside it. -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="CoverHost"
                    Width="80"
                    Height="80"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    DoubleTapped="OnRestoreTapped"
                    ToolTipService.ToolTip="Open the full player"
                    AutomationProperties.Name="Open the full player">
                    <Grid>
                        <FontIcon
                            x:Name="CoverGlyph"
                            Glyph="&#xE8D6;"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Image x:Name="CoverImage" helpers:Art.Pixels="80" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel
                    x:Name="TitleBlock"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        x:Name="TitleText"
                        Text="Nothing playing"
                        FontSize="19"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        AutomationProperties.Name="Track title" />
                    <TextBlock
                        x:Name="ArtistText"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        AutomationProperties.Name="Track artist" />
                </StackPanel>
            </Grid>

            <!-- The expanded card: the words or the queue, between the track strip and the
                 transport. Zero height and hidden while the card is compact. -->
            <Grid x:Name="PanelHost" Grid.Row="1" Margin="0,6,0,0" Visibility="Collapsed">
                <controls:InlineLyricsPane x:Name="LyricsPane" />
                <controls:InlineQueuePane x:Name="QueuePane" Visibility="Collapsed" />
            </Grid>

            <!-- Current time, the same default Slider the player bar uses,
                 and the remaining time. -->
            <Grid Grid.Row="2" Margin="0,6,0,0" ColumnSpacing="10" Padding="12,0,12,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="ElapsedText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    MinWidth="24"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    AutomationProperties.Name="Elapsed time" />

                <Slider
                    x:Name="Progress"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="1"
                    IsThumbToolTipEnabled="False"
                    ValueChanged="OnProgressChanged"
                    AutomationProperties.Name="Playback position" />

                <TextBlock
                    x:Name="RemainingText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    MinWidth="28"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    AutomationProperties.Name="Remaining time" />
            </Grid>

            <!-- The left cluster, the transport centered in the card, and the right
                 cluster. The star columns are equal, so the transport stays centered. -->
            <Grid Grid.Row="3" Margin="0,6,0,0" Padding="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <Button
                        x:Name="VolumeButton"
                        Style="{StaticResource MiniGlyphButton}"
                        ToolTipService.ToolTip="Volume"
                        AutomationProperties.Name="Volume">
                        <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="18" />
                        <Button.Flyout>
                            <Flyout Placement="Top" Opening="OnVolumeFlyoutOpening">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="8" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel Orientation="Horizontal" Spacing="8" Width="200">
                                    <Button
                                        x:Name="MuteButton"
                                        Style="{StaticResource MiniGlyphButton}"
                                        Click="OnMuteClick"
                                        ToolTipService.ToolTip="Mute"
                                        AutomationProperties.Name="Mute">
                                        <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="18" />
                                    </Button>
                                    <Slider
                                        x:Name="VolumeSlider"
                                        Width="150"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="100"
                                        AutomationProperties.Name="Volume" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="MoreButton"
                        Style="{StaticResource MiniGlyphButton}"
                        Click="OnMoreClick"
                        ToolTipService.ToolTip="More options"
                        AutomationProperties.Name="More options">
                        <FontIcon Glyph="&#xE712;" FontSize="18" />
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <Button
                        x:Name="PreviousButton"
                        Style="{StaticResource MiniTransportButton}"
                        Click="OnPreviousClick"
                        ToolTipService.ToolTip="Previous"
                        AutomationProperties.Name="Previous">
                        <FontIcon Glyph="&#xF8AC;" FontSize="18" />
                    </Button>
                    <Button
                        x:Name="PlayButton"
                        Style="{StaticResource MiniPlayButton}"
                        Click="OnPlayClick"
                        ToolTipService.ToolTip="Play"
                        AutomationProperties.Name="Play">
                        <Grid>
                            <FontIcon x:Name="PlayIcon" Glyph="&#xF5B0;" FontSize="20" />
                            <ProgressRing
                                x:Name="LoadingRing"
                                Width="17"
                                Height="17"
                                IsActive="False"
                                Visibility="Collapsed"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="NextButton"
                        Style="{StaticResource MiniTransportButton}"
                        Click="OnNextClick"
                        ToolTipService.ToolTip="Next"
                        AutomationProperties.Name="Next">
                        <FontIcon Glyph="&#xF8AD;" FontSize="18" />
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <ToggleButton
                        x:Name="LyricsButton"
                        Style="{StaticResource MiniToggleButton}"
                        Click="OnLyricsClick"
                        ToolTipService.ToolTip="Show lyrics"
                        AutomationProperties.Name="Show lyrics">
                        <FontIcon Glyph="&#xE8BD;" FontSize="18" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="QueueButton"
                        Style="{StaticResource MiniToggleButton}"
                        Click="OnQueueClick"
                        ToolTipService.ToolTip="Show queue"
                        AutomationProperties.Name="Show queue">
                        <FontIcon Glyph="&#xE8FD;" FontSize="18" />
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- The title bar reaches into the page. The WinUI TitleBar control owns the drag
             region and the space the native Close button needs; the app's full-player
             button is its right header, so it sits beside Close and stays clickable. -->
        <TitleBar
            x:Name="MiniTitleBar"
            Height="32"
            VerticalAlignment="Top"
            Background="Transparent"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            Loaded="OnTitleBarLoaded">
            <TitleBar.Resources>
                <!-- The compact overlay's caption buttons are 32 DIP tall, and the card is
                     only 425 DIP wide. Keep the control's internal layout compact too;
                     a right header alone would otherwise make it 48 tall and clip the
                     button against the card. The default 48 DIP drag strip between the
                     header and Close would also leave the expand button floating far from
                     the caption buttons; the rest of the bar still drags the window. -->
                <x:Double x:Key="TitleBarCompactHeight">32</x:Double>
                <x:Double x:Key="TitleBarExpandedHeight">32</x:Double>
                <x:Double x:Key="TitleBarMinDragRegionWidth">1</x:Double>
                <!-- The overlay's buttons stay visible when another window has focus,
                 the same as the native Close beside them. -->
                <x:Double x:Key="TitleBarDeactivatedOpacity">1</x:Double>
            </TitleBar.Resources>
            <TitleBar.RightHeader>
                <Button
                    x:Name="RestoreButton"
                    Style="{StaticResource MiniCaptionButton}"
                    Click="OnRestoreClick"
                    ToolTipService.ToolTip="Open the full player"
                    AutomationProperties.Name="Open the full player">
                    <FontIcon
                        Glyph="&#xE740;"
                        FontSize="12"
                        Foreground="{Binding Foreground, ElementName=RestoreButton}">
                        <!-- The E740 ink sits about a pixel below the Close glyph's optical
                        center; lift it so the two icons read on the same line. -->
                        <FontIcon.RenderTransform>
                            <TranslateTransform Y="-1" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>
    </Grid>
</Page>
